// Formalization memo for the pull-request review flow state machine.
//
// ASSUME-1: one Pull Request and one review cycle are modeled at a time.
// ASSUME-2: a single combined review outcome is modeled; parallel reviewer
//           threads are not represented here.
// ASSUME-3: the fix owner's work is modeled in two observable steps, because
//           Issue #237 moved fixing and publishing into one skill (fix-pr):
//           fix() records that the returned findings were addressed locally,
//           and publish_fix() records that the fixed commit became the Pull
//           Request head. Only publish_fix() readies the Pull Request for
//           re-review, so a fix that was committed but never pushed cannot
//           reach ReadyForReview. The content of the fixes is outside scope.
// ASSUME-4: merge and closure are implementation-phase actions outside this
//           review-flow model; it records the permission to merge, not the
//           merge itself.
// ASSUME-5: head_published is false whenever local fix work is outstanding; it
//           abstracts "the reviewed commit equals the Pull Request head" to a
//           single Boolean rather than modeling commit graphs.
spec ReviewFlow {
  enum Status {
    Draft,
    ReadyForReview,
    UnderReview,
    ChangesRequested,
    Fixed,
    Approved,
    Merged,
    Blocked
  }

  state {
    status: Status,
    reviewed: Bool,
    approved: Bool,
    merge_ready: Bool,
    head_published: Bool
  }

  init {
    status = Draft
    reviewed = false
    approved = false
    merge_ready = false
    head_published = true
  }

  action submit() {
    requires status == Draft
    status = ReadyForReview
  }

  action block_no_review() {
    requires status == Draft
    status = Blocked
  }

  action start_review() {
    requires status == ReadyForReview
    reviewed = true
    status = UnderReview
  }

  action approve() {
    requires status == UnderReview
    requires reviewed
    approved = true
    merge_ready = true
    status = Approved
  }

  action request_changes() {
    requires status == UnderReview
    requires reviewed
    status = ChangesRequested
  }

  action fix() {
    requires status == ChangesRequested
    head_published = false
    status = Fixed
  }

  action publish_fix() {
    requires status == Fixed
    requires not head_published
    head_published = true
    status = ReadyForReview
  }

  action merge() {
    requires status == Approved
    requires approved
    requires merge_ready
    requires head_published
    status = Merged
  }

  invariant ApprovedOnlyAfterReview {
    approved => reviewed
  }

  invariant MergedOnlyAfterApproval {
    status == Merged => approved
  }

  invariant MergedOnlyWhenMergeReady {
    status == Merged => merge_ready
  }

  invariant ChangesRequestedIsNotApproved {
    status == ChangesRequested => not approved
  }

  invariant FixedIsNotApproved {
    status == Fixed => not approved
  }

  invariant ReviewNeedsPublishedHead {
    status == ReadyForReview or status == UnderReview => head_published
  }

  invariant MergedOnlyWithPublishedHead {
    status == Merged => head_published
  }

  terminal {
    status == Merged or status == Blocked
  }

  reachable ApprovedPendingMerge { status == Approved }
  reachable MergedAfterApproval { status == Merged }
  reachable ReworkLoop { status == ChangesRequested }
  reachable UnpublishedFix { status == Fixed and not head_published }
  reachable RepublishedAfterFix { status == ReadyForReview and reviewed }
}
