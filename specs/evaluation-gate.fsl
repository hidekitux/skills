// Catalog status promotion gate for behavioral evaluation evidence.
//
// Formalization memo (Issue 173, comment #issuecomment-5413886905):
// ASSUME-1: status values match internal/validate/repository.go validStatuses
//           (experimental, stable, deprecated).
// ASSUME-2: evidence records retained machine-readable evaluation reports with
//           passing verdicts under evaluations/reports/; the numeric threshold
//           is documented in docs/evaluation.md and enforced by
//           check-evaluation, not modeled here.
// ASSUME-3: demote models a recorded deterministic regression; promotion back
//           to stable requires a fresh passing record and is gated by the same
//           evidence requirement.
// ASSUME-4: deprecation is terminal in this model; publication ordering stays
//           in release-gate.fsl and is not duplicated here.
//
// Formalization memo (Issue 367, comment #issuecomment-5810685942):
// ASSUME-5: fresh records whether the retained evidence's input digest matches
//           the skill's current input set (docs/evaluation.md). A commit
//           outside the input set changes no state, so no action models it.
//           promoted_fresh records the freshness at the last promotion, so
//           StablePromotedWithFreshEvidence detects a promotion on stale
//           evidence even after a later relevant change clears fresh.
spec EvaluationGate {
  enum Status { Experimental, Stable, Deprecated }

  state {
    status: Status,
    evidence: Bool,
    fresh: Bool,
    promoted_fresh: Bool
  }

  init {
    status = Experimental
    evidence = false
    fresh = false
    promoted_fresh = false
  }

  // A passing behavioral evaluation is recorded at the current input digest.
  // Evidence may exist without promotion, and a stable skill may refresh its
  // evidence after a relevant change.
  action record_evidence() {
    requires status == Experimental or status == Stable
    evidence = true
    fresh = true
  }

  // A commit to the skill's directory, a shared input, or the evaluation
  // harness changes the input digest and makes the retained evidence stale.
  action change_relevant_input() {
    requires status != Deprecated
    fresh = false
  }

  // Promotion from experimental to stable requires retained behavioral
  // evidence at the current input digest per docs/evaluation.md.
  action promote() {
    requires status == Experimental
    requires evidence
    requires fresh
    promoted_fresh = fresh
    status = Stable
  }

  // A recorded regression demotes a stable skill and clears its evidence, so
  // re-promotion needs a fresh passing record.
  action demote() {
    requires status == Stable
    evidence = false
    status = Experimental
  }

  // Experimental and stable skills may be deprecated; deprecation is terminal
  // and clears the promotion evidence, so a deprecated skill never carries a
  // live promotion gate.
  action deprecate() {
    requires status == Experimental or status == Stable
    evidence = false
    status = Deprecated
  }

  invariant StableRequiresEvidence {
    status == Stable => evidence
  }

  invariant StablePromotedWithFreshEvidence {
    status == Stable => promoted_fresh
  }

  invariant EvidenceRequiresExperimentalOrStable {
    evidence => status != Deprecated
  }

  invariant DemotedIsNotStable {
    status == Experimental => not (status == Stable)
  }

  terminal { status == Deprecated }

  reachable StableSealedByEvidence { status == Stable }
  reachable DemotionRestoresExperimental { status == Experimental }
  reachable DeprecatedEnd { status == Deprecated }
  reachable StaleEvidenceBlocksPromotion { status == Experimental and evidence and not fresh }
}