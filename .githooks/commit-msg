#!/bin/sh
set -eu

root=$(git rev-parse --show-toplevel)
commitlint_bin="${root}/.mise/bin/commitlint"
validator_bin="${root}/.mise/bin/validate-commit-message"

cd "${root}"

if [ ! -x "${validator_bin}" ]; then
  echo "validate-commit-message is not installed for this project." >&2
  echo "Run: mise run setup:commitlint" >&2
  exit 2
fi
"${validator_bin}" --message "$(cat "$1")"

if [ ! -x "${commitlint_bin}" ]; then
  echo "commitlint is not installed for this project." >&2
  echo "Run: mise run setup:commitlint" >&2
  exit 2
fi

"${commitlint_bin}" lint --message "$1"
