#!/bin/sh
set -eu

# Git passes 1 as the third argument for branch checkouts and 0 for file
# checkouts. Refresh local setup only when the checked-out branch may have
# changed.
[ "$3" = "1" ] || exit 0

if ! mise run setup:refresh; then
  echo "Warning: Local setup refresh did not complete. Rerun 'mise run setup:refresh' after resolving the reported error." >&2
  exit 0
fi

echo "Local setup refresh complete for $(git rev-parse --short HEAD)."
